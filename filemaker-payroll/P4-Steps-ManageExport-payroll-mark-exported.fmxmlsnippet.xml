<Step enable="True" id="76" name="Set Field"><DisableStepCollapsed state="False"/><Calculation><![CDATA[$exportTS]]></Calculation><Field table="SessionNote" id="0" name="payrollExportedTS"/></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( LastError ) <> 0]]></Calculation></Step>
