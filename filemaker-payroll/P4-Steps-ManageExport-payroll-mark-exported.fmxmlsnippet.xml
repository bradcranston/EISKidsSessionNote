<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Payroll"]]></Calculation></Title><Message><Calculation><![CDATA["The payroll file was saved, but these notes are open on another computer and could not be marked as paid. They will appear again in the next New Only payroll export. Take them out of that file so they are not paid twice:¶¶" & $notMarked]]></Calculation></Message><Buttons><Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button><Button CommitState="False"/><Button CommitState="False"/></Buttons></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
