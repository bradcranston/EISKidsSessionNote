<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>9/16/26: cfSupervisorId / cotaSupervisorId hold the supervisor's UserAccount __ID (that is what the Accounts page saves). The old lookup compared them to the supervisor's staffId, never matched, and supervisors could only see their own notes. gLoggedIn is still a list of STAFF ids - the SessionNote record-level access calc filters on staffId.</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[PatternCount ( Get ( AccountPrivilegeSetName ) ; "Supervisor" )]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[ExecuteSQL ( "SELECT \"__ID\" FROM \"UserAccount\" WHERE \"username\" = ?" ; "" ; "" ; Get ( AccountName ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$userId</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[ExecuteSQL ( "SELECT \"staffId\" FROM \"UserAccount\" WHERE \"username\" = ?" ; "" ; "" ; Get ( AccountName ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$staffId</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[ExecuteSQL ( "SELECT \"staffId\" FROM \"UserAccount\" WHERE \"cfSupervisorId\" = ? OR \"cotaSupervisorId\" = ?" ; "" ; "" ; $userId ; $userId )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$team</Name></Step>
<Step enable="True" id="76" name="Set Field"><DisableStepCollapsed state="False"/><Calculation><![CDATA[ValuesRemoveEmptyValues ( $staffId & ¶ & $team )]]></Calculation><Field table="UserAccount" id="0" name="gLoggedIn"/></Step>
<Step enable="True" id="125" name="Else If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( AccountPrivilegeSetName ) = "Interventionist" or Get ( AccountPrivilegeSetName ) = "COTA" or Get ( AccountPrivilegeSetName ) = "CF"]]></Calculation></Step>
<Step enable="True" id="76" name="Set Field"><DisableStepCollapsed state="False"/><Calculation><![CDATA[ExecuteSQL ( "SELECT \"staffId\" FROM \"UserAccount\" WHERE \"username\" = ?" ; "" ; "" ; Get ( AccountName ) )]]></Calculation><Field table="UserAccount" id="0" name="gLoggedIn"/></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
</fmxmlsnippet>
