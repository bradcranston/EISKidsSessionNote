<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Let ( ~v = JSONGetElement ( $r ; "sealed" ) ; ~v = 1 or ~v = "true" )]]></Calculation></Step>
