<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>A canceled note only ever needed its description - the old form passed it without flagging awaitingSignaturesOnly.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Trim ( SessionNote::sessionStatus ) <> "H - Held" and not IsEmpty ( SessionNote::cancellationDescription )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$met</Name></Step>
<Step enable="True" id="1" name="Perform Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "" ; ["id" ; $id ; JSONString] ; ["requirementsMet" ; $met ; JSONBoolean] )]]></Calculation><Script id="0" name="SessionNote: Seal If Complete"/></Step>
