<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>9/16/26: the widget sends viewOnly as a JSON boolean, which JSONGetElement returns as 1 - never equal to the text "true". Accept both.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$step = "commit" and Let ( ~v = JSONGetElement ( $data ; "viewOnly" ) ; ~v = 1 or ~v = "true" )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$widgetWantsLock</Name></Step>
</fmxmlsnippet>
