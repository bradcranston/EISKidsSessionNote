<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Supervisor name and credentials under the supervisor signature (page 1, bottom-up coordinates).
$supX / $supY are the top-left of the text. Adjust them if it collides with the template's printed labels.</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[not IsEmpty ( SessionNote::supervisorName )]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[260]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$supX</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[146]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$supY</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[MBS ( "DynaPDF.SetFont" ; $pdf ; "Helvetica" ; "regular" ; 6 ; 1 ; "Unicode" )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$write</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[MBS ( "DynaPDF.WriteFTextEx" ; $pdf ; $supX ; $supY ; 130 ; -1 ; "left" ;
  Substitute ( SessionNote::supervisorName & If ( IsEmpty ( SessionNote::supervisorCredentials ) ; "" ; ", " & SessionNote::supervisorCredentials ) ; "\\" ; "\\\\" ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$write</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
</fmxmlsnippet>
