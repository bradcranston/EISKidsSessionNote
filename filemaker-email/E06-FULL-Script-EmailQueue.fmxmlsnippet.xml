<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Description: emails every sealed session note that has not gone to the family yet. Run it from a FileMaker Server schedule (every 5 minutes) - it is also called from the MirrorSync hub DidSync step so synced notes go out right after a sync.
THE QUEUE: status = Final AND not voided AND not awaiting the supervisor AND ( emailStatus is empty OR Waiting for Sync OR ( emailStatus = Failed AND emailAttempts &lt; 3 ) ).
PARAMETER (optional): {&quot;limit&quot;: n} - default 50 per run; the rest wait for the next run.
BEFORE THE FIRST RUN: run &quot;One Time: Mark Existing Notes Email Skipped&quot; once, or every note already Final is emailed to families.
Creation Date: 9/23/26  By: bc / Claude</Text></Step>
<Step enable="True" id="86" name="Set Error Capture"><Set state="True"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="85" name="Allow User Abort"><Set state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Let ( ~l = GetAsNumber ( JSONGetElement ( Get ( ScriptParameter ) ; "limit" ) ) ; If ( ~l > 0 ; ~l ; 50 ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$limit</Name></Step>
<Step enable="True" id="6" name="Go to Layout"><DisableStepCollapsed state="False"/><LayoutDestination value="SelectedLayout"/><Layout id="3" name="SessionNote"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>10/1/26: recover notes stuck on Sending. The send script commits Sending before it rebuilds the PDF and sends; if that run is cut off (e.g. the MirrorSync Data API session ends mid-send) the note stays on Sending forever, because neither this queue nor the send script will pick it up. Anything on Sending for more than 15 minutes is marked Failed so the normal retry below (emailAttempts &lt; 3) sends it. Records someone has open are left for the next run.</Text></Step>
<Step enable="True" id="28" name="Perform Find"><DisableStepCollapsed state="False"/><Restore state="True"/><Query><RequestRow operation="Include"><Criteria><Field table="SessionNote" id="87" name="status"/><Text>==Final</Text></Criteria><Criteria><Field table="SessionNote" id="120" name="emailStatus"/><Text>==Sending</Text></Criteria></RequestRow></Query></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( FoundCount ) > 0]]></Calculation></Step>
<Step enable="True" id="16" name="Go to Record/Request/Page"><NoInteract state="True"/><DisableStepCollapsed state="False"/><RowPageLocation value="First"/></Step>
<Step enable="True" id="71" name="Loop"><DisableStepCollapsed state="False"/><Restore state="False"/><FlushType value="Always"/></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( CurrentTimestamp ) - SessionNote::zzModificationTimestamp > 900]]></Calculation></Step>
<Step enable="True" id="76" name="Set Field"><DisableStepCollapsed state="False"/><Calculation><![CDATA["Failed"]]></Calculation><Field table="SessionNote" id="120" name="emailStatus"/></Step>
<Step enable="True" id="76" name="Set Field"><DisableStepCollapsed state="False"/><Calculation><![CDATA[Get ( CurrentTimestamp ) & " - attempt " & SessionNote::emailAttempts & ": interrupted before it finished (left as Sending since " & SessionNote::zzModificationTimestamp & ") - queued for retry"]]></Calculation><Field table="SessionNote" id="123" name="emailResult"/></Step>
<Step enable="True" id="75" name="Commit Records/Requests"><NoInteract state="True"/><Option state="False"/><ESSForceCommit state="False"/><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="16" name="Go to Record/Request/Page"><NoInteract state="True"/><Exit state="True"/><DisableStepCollapsed state="False"/><RowPageLocation value="Next"/></Step>
<Step enable="True" id="73" name="End Loop"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>--- end 10/1/26 stuck-Sending recovery ---</Text></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>10/23/26: also picks up Waiting for Sync - notes sealed offline that have now synced.</Text></Step>
<Step enable="True" id="28" name="Perform Find"><DisableStepCollapsed state="False"/><Restore state="True"/><Query><RequestRow operation="Include"><Criteria><Field table="SessionNote" id="87" name="status"/><Text>==Final</Text></Criteria><Criteria><Field table="SessionNote" id="120" name="emailStatus"/><Text>=</Text></Criteria></RequestRow><RequestRow operation="Include"><Criteria><Field table="SessionNote" id="87" name="status"/><Text>==Final</Text></Criteria><Criteria><Field table="SessionNote" id="120" name="emailStatus"/><Text>==Failed</Text></Criteria><Criteria><Field table="SessionNote" id="124" name="emailAttempts"/><Text>&lt;3</Text></Criteria></RequestRow><RequestRow operation="Include"><Criteria><Field table="SessionNote" id="87" name="status"/><Text>==Final</Text></Criteria><Criteria><Field table="SessionNote" id="120" name="emailStatus"/><Text>=="Waiting for Sync"</Text></Criteria></RequestRow><RequestRow operation="Exclude"><Criteria><Field table="SessionNote" id="115" name="awaitingSupervisor"/><Text>1</Text></Criteria></RequestRow><RequestRow operation="Exclude"><Criteria><Field table="SessionNote" id="110" name="voidedTS"/><Text>*</Text></Criteria></RequestRow></Query></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( LastError ) = 401 or Get ( FoundCount ) = 0]]></Calculation></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "" ; ["queued";0;JSONNumber] ; ["sent";0;JSONNumber] ; ["notSent";0;JSONNumber] )]]></Calculation></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Collect the IDs first - the send script changes the found set.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( FoundCount )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$queued</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[""]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$ids</Name></Step>
<Step enable="True" id="16" name="Go to Record/Request/Page"><NoInteract state="True"/><DisableStepCollapsed state="False"/><RowPageLocation value="First"/></Step>
<Step enable="True" id="71" name="Loop"><DisableStepCollapsed state="False"/><Restore state="False"/><FlushType value="Always"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[List ( $ids ; SessionNote::__ID )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$ids</Name></Step>
<Step enable="True" id="16" name="Go to Record/Request/Page"><NoInteract state="True"/><Exit state="True"/><DisableStepCollapsed state="False"/><RowPageLocation value="Next"/></Step>
<Step enable="True" id="73" name="End Loop"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[0]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$i</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[0]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$sent</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[0]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$notSent</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[""]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$log</Name></Step>
<Step enable="True" id="71" name="Loop"><DisableStepCollapsed state="False"/><Restore state="False"/><FlushType value="Always"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$i + 1]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$i</Name></Step>
<Step enable="True" id="72" name="Exit Loop If"><DisableStepCollapsed state="False"/><Calculation><![CDATA[$i > ValueCount ( $ids ) or $i > $limit]]></Calculation></Step>
<Step enable="True" id="1" name="Perform Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "" ; ["id";GetValue ( $ids ; $i );JSONString] )]]></Calculation><Script id="177" name="SessionNote: Email Sealed PDF (Server)"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( ScriptResult )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$r</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[GetAsBoolean ( JSONGetElement ( $r ; "sent" ) )]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$sent + 1]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$sent</Name></Step>
<Step enable="True" id="69" name="Else"><DisableStepCollapsed state="False"/><Restore state="False"/></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[$notSent + 1]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$notSent</Name></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[List ( $log ; GetValue ( $ids ; $i ) & " - " & JSONGetElement ( $r ; "reason" ) )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$log</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="73" name="End Loop"><DisableStepCollapsed state="False"/></Step>
<Step enable="True" id="103" name="Exit Script"><DisableStepCollapsed state="False"/><Calculation><![CDATA[JSONSetElement ( "" ; ["queued";$queued;JSONNumber] ; ["sent";$sent;JSONNumber] ; ["notSent";$notSent;JSONNumber] ; ["log";$log;JSONString] )]]></Calculation></Step>
</fmxmlsnippet>
