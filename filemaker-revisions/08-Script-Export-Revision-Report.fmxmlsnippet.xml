<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>Newest note in the revision chain</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[While ( [
    ~id = SessionNote::supersededBy_Id
  ; ~guard = 0
] ;
  ~guard < 50 ;
[
    ~next = ExecuteSQL ( "SELECT \"supersededBy_Id\" FROM \"SessionNote\" WHERE \"__ID\" = ?" ; "" ; "" ; ~id )
  ; ~guard = If ( IsEmpty ( ~next ) ; 50 ; ~guard + 1 )
  ; ~id = If ( IsEmpty ( ~next ) ; ~id ; ~next )
] ;
  ~id
)]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$latestId</Name></Step>
