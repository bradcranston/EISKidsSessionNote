<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>9/16/26: Final and Void notes are the legal record and cannot be deleted. Deleting an unfinished REVISION abandons it and puts the original back to Final.</Text></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[Get ( LastError )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$findError</Name></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$findError = 0 and ( SessionNote::status = "Final" or SessionNote::status = "Void" )]]></Calculation></Step>
<Step enable="True" id="87" name="Show Custom Dialog"><DisableStepCollapsed state="False"/><Title><Calculation><![CDATA["Cannot delete"]]></Calculation></Title><Message><Calculation><![CDATA["Final and voided session notes cannot be deleted. Open the note and use Revise Note to correct it."]]></Calculation></Message><Buttons><Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button><Button CommitState="False"/><Button CommitState="False"/></Buttons></Step>
<Step enable="True" id="125" name="Else If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[$findError = 0]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[SessionNote::revisionOf_Id]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$restoreId</Name></Step>
<Step enable="True" id="9" name="Delete Record/Request"><DisableStepCollapsed state="False"/><NoInteract state="True"/></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[not IsEmpty ( $restoreId ) and Get ( LastError ) = 0]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA["==" & $restoreId]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$find</Name></Step>
<Step enable="True" id="28" name="Perform Find"><DisableStepCollapsed state="False"/><Restore state="True"/><Query><RequestRow operation="Include"><Criteria><Field table="SessionNote" id="1" name="__ID"/><Text>$find</Text></Criteria></RequestRow></Query></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[Get ( FoundCount ) = 1 and SessionNote::status = "Void"]]></Calculation></Step>
<Step enable="True" id="76" name="Set Field"><DisableStepCollapsed state="False"/><Calculation><![CDATA["Final"]]></Calculation><Field table="SessionNote" id="87" name="status"/></Step>
