<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)"><DisableStepCollapsed state="False"/><Restore state="False"/><Text>10/21/26 bc: a voided note's PDF is labeled _VOID (after any _REV), e.g. ..._REV1_VOID.pdf.</Text></Step>
<Step enable="True" id="68" name="If"><DisableStepCollapsed state="False"/><Restore state="False"/><Calculation><![CDATA[SessionNote::status = "Void"]]></Calculation></Step>
<Step enable="True" id="141" name="Set Variable"><DisableStepCollapsed state="False"/><Value><Calculation><![CDATA[If ( Right ( $fileName ; 4 ) = ".pdf" ;
  Left ( $fileName ; Length ( $fileName ) - 4 ) & "_VOID.pdf" ;
  $fileName & "_VOID" )]]></Calculation></Value><Repetition><Calculation><![CDATA[1]]></Calculation></Repetition><Name>$fileName</Name></Step>
<Step enable="True" id="70" name="End If"><DisableStepCollapsed state="False"/></Step>
</fmxmlsnippet>
